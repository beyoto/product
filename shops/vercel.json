{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/:store(asiamixx|aveline|baha|crowncarat|ernis|etno|hayk|myrza|nova)/:path*", "destination": "/:store/index.html" },
    { "source": "/:slug", "destination": "/_app/index.html" },
    { "source": "/:slug/(.*)", "destination": "/_app/index.html" }
  ]
}
